{
  "version": 1,
  "project": "Glyph Matter",
  "createdDateJst": "2026-10-02",
  "purpose": "Fresh synthetic Japanese semantic cases for a finite part-and-relation DSL. Created after the parent froze the inference contract, before this agent observed any inference output.",
  "provenance": {
    "source": "All text and expectations authored for this evaluation by a read-only research subagent; no user writing, attached documents, or personal data reused.",
    "trainingUse": "Do not use these cases to train, select thresholds, craft per-case dictionaries, or revise prompts before the first locked inference run.",
    "blindness": "Artificial cases known to their author and available to the implementation team; not a human participant study, not externally blinded, and pretraining exposure is unknown.",
    "priorDatasetCheck": "Checked exact and Unicode-normalized duplicate text against available earlier local JSON evaluation fixtures; summary reported separately to the parent."
  },
  "contract": {
    "actions": [
      "make",
      "keep",
      "unsupported"
    ],
    "partIds": [
      "a",
      "b",
      "c",
      "d"
    ],
    "maxParts": 4,
    "shape": [
      "sphere",
      "box",
      "cylinder",
      "cone",
      "torus"
    ],
    "nRange": [
      1,
      8
    ],
    "size": [
      "normal",
      "small",
      "large"
    ],
    "stretch": [
      "none",
      "x",
      "y",
      "z"
    ],
    "color": [
      "white",
      "red",
      "yellow",
      "blue",
      "green",
      "purple",
      "black"
    ],
    "relation": [
      "above",
      "below",
      "left",
      "right",
      "inside",
      "around",
      "concentric",
      "chain",
      "cross",
      "touch"
    ],
    "maxRelations": 4,
    "defaultAttributes": {
      "n": 1,
      "size": "normal",
      "stretch": "none",
      "color": "white"
    }
  },
  "scoring": {
    "schema": "Measure schema validity separately from semantic correctness.",
    "matching": "Expected objects show one canonical valid graph, not byte-for-byte JSON targets. Node IDs and array ordering are arbitrary; compare under a one-to-one node renaming while preserving per-node properties and counts.",
    "relations": "above(a,b) is equivalent to below(b,a); left(a,b) to right(b,a). touch, concentric, cross, and chain are symmetric. inside and around are directed. Duplicate equivalent relations do not increase success.",
    "scope": "Require requested subjects, count, explicit per-part properties and explicit relations; reject contradicted or extra geometry under forbidden constraints. Defaults provide expected examples but do not substitute for stated semantic criteria.",
    "geometry": "Semantic graph success does not establish a valid or attractive 3D construction. Independently inspect contact, crossing, chain topology, surface coverage, silhouette, and text preservation.",
    "policy": "unsupported is appropriate for an explicit request outside the frozen grammar or its budgets. keep means no geometric request; both preserve already accepted text. This keep policy is a fixed evaluation choice, not a claim that all creative uses require it.",
    "statistics": "Report make/keep/unsupported, negation, counts, attributes and relations separately. Do not turn these 24 artificial examples into Japanese-general accuracy."
  },
  "cases": [
    {
      "id": "dsl-01",
