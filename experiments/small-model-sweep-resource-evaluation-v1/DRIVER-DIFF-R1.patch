+def cpu_counter(server, port):
+    assert_owned(server, port)
+    value = subprocess.run(["ps", "-o", "time=", "-p", str(server.pid)], capture_output=True, text=True, timeout=2).stdout.strip()
+    days = 0
+    if "-" in value:
+        d, value = value.split("-", 1)
+        days = int(d)
+    parts = value.split(":")
+    if len(parts) not in {2, 3}:
+        raise ValueError("unsupported_ps_cpu_time")
+    seconds = float(parts[-1]) + int(parts[-2]) * 60 + days * 86400
+    if len(parts) == 3:
+        seconds += int(parts[0]) * 3600
+    return seconds, value
 
 
